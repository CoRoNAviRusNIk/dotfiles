[
  // Ноут

  {
    "output": "eDP-1",
    "layer": "top",
    "position": "top",
    "height": 26,
    "exclusive": true,
    "modules-left": [
      "hyprland/workspaces",
      "custom/text",
      "cpu",
      "memory",
      "temperature"
